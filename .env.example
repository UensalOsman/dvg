# Camunda Cloud Credentials
# Zu finden in: Camunda Console → Cluster → API → Client erstellen
ZEEBE_CLIENT_ID=...
ZEEBE_CLIENT_SECRET=...
ZEEBE_CLUSTER_ID=...
ZEEBE_REGION=...

# Job-Types (müssen mit den Service-Task-Typen im BPMN übereinstimmen)
JOB_TYPE_METADATA=g3-save-metadata
JOB_TYPE_PAYMENT=g3-execute-payment

# BPMN-Prozess-ID (steht im BPMN-Modell unter "Process Id")
CAMUNDA_PROCESS_ID=rechnungsverarbeitung
